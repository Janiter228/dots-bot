# HTTP-порт сервера. Пустое значение использует 4003 (порт контейнера в Compose).
PORT=
# Защищает /v1/move. Оставьте пустым, пока токен не задан в кабинете арены;
# когда задан, значения в кабинете и здесь должны совпадать.
BOT_TOKEN=
# Свой пароль команды для истории партий, не токен арены. Генерация: openssl rand -hex 24.
DASHBOARD_TOKEN=
