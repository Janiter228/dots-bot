# HTTP-порт сервера. Пустое значение использует 4003 (порт контейнера в Compose).
PORT=
# Защищает /v1/move. Оставьте пустым, пока токен не задан в кабинете арены;
# когда задан, значения в кабинете и здесь должны совпадать.
BOT_TOKEN=
# Свой пароль команды для истории партий, не токен арены. Генерация: openssl rand -hex 24.
DASHBOARD_TOKEN=
# Соль и scrypt-хеш PIN для входа через «Наш токен», формат salt:hash.
DASHBOARD_ACCESS_PASSWORD_HASH=
# SHA-256 от строки «Bearer <токен>», нужен для входа через кнопку «Наш токен».
DASHBOARD_ACCESS_TOKEN_HASH=

# Общий лимит HTTP-запроса хода и режим локальных советников.
MAX_RESPONSE_TIME_MS=2000
DOTS_AI_MODE=autonomous
